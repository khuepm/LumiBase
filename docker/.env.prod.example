# ────────────────────────────────────────────────────────────────────────────
# LumiBase — production .env for the Google Cloud single-VM deploy.
#
#   cp .env.prod.example .env   (in the docker/ directory)
#
# Then fill EVERY value below. The docker-compose.gcp.yml overlay fails fast
# (`:?` markers) if a required secret is missing, and the CMS itself runs
# validateProductionConfig() on boot — it rejects empty values, the dev
# defaults (minioadmin / lumibase_dev_key / 736563726574), a non-AES
# ENCRYPTION_KEY, a DATABASE_URL without sslmode, and a "*" CORS origin.
#
# Generate-it-yourself commands are shown next to each secret. NEVER commit the
# resulting .env — it is git-ignored.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Password for the in-cluster Postgres container. DATABASE_URL is assembled
# from this inside the overlay, so you only set the password here.
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# ── Object storage (MinIO, S3-compatible) ───────────────────────────────────
# Used as the MinIO root user/password AND the CMS/imgproxy S3 credentials.
# Must NOT be "minioadmin".
#   S3_ACCESS_KEY: openssl rand -hex 12
#   S3_SECRET_KEY: openssl rand -hex 24
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Search (MeiliSearch) ────────────────────────────────────────────────────
# Master key. Must NOT be "lumibase_dev_key".
#   openssl rand -hex 24
MEILISEARCH_API_KEY=

# ── Image proxy (imgproxy) ──────────────────────────────────────────────────
# Hex-encoded key/salt. Must NOT be "736563726574".
#   IMGPROXY_KEY:  openssl rand -hex 32
#   IMGPROXY_SALT: openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=

# ── Auth + encryption ───────────────────────────────────────────────────────
# JWT signing secret.
#   openssl rand -base64 48
JWT_SECRET=
# AES-GCM data-encryption key — MUST decode to exactly 16, 24, or 32 bytes.
# A 32-byte (256-bit) key:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated Studio/app origins. Must NOT contain "*".
# Example: https://studio.yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

# ── LLM provider: Gemini (Google AI Studio) ─────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional model override; leave commented to use the provider default.
# LLM_MODEL=gemini-3.5-flash

# ── Host port for the CMS (the only service published on the VM) ─────────────
CMS_PORT=1989
