{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Request body size cap (high-load-cache-readiness Req 6.1). A single
	# oversized payload should be rejected at the edge before it reaches the
	# app. Media uploads have their own (larger) bound and their own limit,
	# so exempt that route here and let FILE_UPLOAD_MAX_BYTES govern it.
	@not_media {
		not path /api/v1/media* /api/v1/files*
	}
	request_body @not_media {
		max_size 10MB
	}
	# Media/asset uploads: higher ceiling; keep in sync with FILE_UPLOAD_MAX_BYTES.
	@media {
		path /api/v1/media* /api/v1/files*
	}
	request_body @media {
		max_size 50MB
	}

	reverse_proxy cms:1989
}
