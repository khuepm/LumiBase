# Lumibase Docker Environment Variables
# Copy this file to .env and adjust values for your environment.

# Runtime mode (docker or cloudflare)
LUMIBASE_RUNTIME=docker

# PostgreSQL connection
DATABASE_URL=postgresql://lumibase:lumibase_dev@postgres:5432/lumibase
# Optional secret-file alternative. If DATABASE_URL is unset, Docker entrypoint
# reads the value from this file path before migrations/server startup.
DATABASE_URL_FILE=
# Production defaults to requiring sslmode=require/verify-ca/verify-full.
# Set DATABASE_SSL_MODE=disable only for private non-TLS test stacks.
DATABASE_SSL_MODE=require

# Redis connection
REDIS_URL=redis://redis:6379
REDIS_URL_FILE=

# S3-compatible storage (MinIO for local dev)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumibase-media

# MeiliSearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=lumibase_dev_key

# Imgproxy
IMGPROXY_URL=http://imgproxy:8080
IMGPROXY_KEY=736563726574
IMGPROXY_SALT=736563726574

# CMS server port
PORT=1989

# Pressure limiter (Node/Docker CMS overload protection)
# Returns HTTP 503 with Retry-After when the Node.js event loop is overloaded.
LUMIBASE_PRESSURE_LIMITER_ENABLED=true
LUMIBASE_PRESSURE_LIMITER_SAMPLE_INTERVAL=250
LUMIBASE_PRESSURE_LIMITER_MAX_EVENT_LOOP_DELAY=1000
# Set to a value such as 0.99 to also reject requests when event loop utilization is too high.
LUMIBASE_PRESSURE_LIMITER_MAX_EVENT_LOOP_UTILIZATION=false
LUMIBASE_PRESSURE_LIMITER_RETRY_AFTER=5
LUMIBASE_PRESSURE_LIMITER_EXCLUDED_PATHS=/health,/metrics

# Production TLS reverse proxy overlay (docker-compose.tls.yml)
PUBLIC_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Optional host port overrides for docker-compose.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEILISEARCH_PORT=7700
IMGPROXY_PORT=8080
CMS_PORT=1989
BULL_BOARD_PORT=3001

# Authentication (OIDC via Logto)
LOGTO_ISSUER=
LOGTO_AUDIENCE=
JWT_SECRET=
JWT_SECRET_FILE=

# Encryption key for sensitive data (base64-encoded AES-GCM key)
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=

# Comma-separated frontend origins allowed by CORS.
# Example: https://studio.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=
