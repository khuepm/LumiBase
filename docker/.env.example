# Lumibase Docker Environment Variables
# Copy this file to .env and adjust values for your environment.

# Runtime mode (docker or cloudflare)
LUMIBASE_RUNTIME=docker

# PostgreSQL connection
DATABASE_URL=postgresql://lumibase:lumibase_dev@postgres:5432/lumibase
# Optional secret-file alternative. If DATABASE_URL is unset, Docker entrypoint
# reads the value from this file path before migrations/server startup.
DATABASE_URL_FILE=
# Production defaults to requiring sslmode=require/verify-ca/verify-full.
# Set DATABASE_SSL_MODE=disable only for private non-TLS test stacks.
DATABASE_SSL_MODE=require

# Redis connection
REDIS_URL=redis://redis:6379
REDIS_URL_FILE=

# S3-compatible storage (MinIO for local dev)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumibase-media

# MeiliSearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=lumibase_dev_key

# Imgproxy
IMGPROXY_URL=http://imgproxy:8080
IMGPROXY_KEY=736563726574
IMGPROXY_SALT=736563726574

# CMS server port
PORT=1989

# Optional host port overrides for docker-compose.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEILISEARCH_PORT=7700
IMGPROXY_PORT=8080
CMS_PORT=1989
BULL_BOARD_PORT=3001

# Authentication (OIDC via Logto)
LOGTO_ISSUER=
LOGTO_AUDIENCE=
JWT_SECRET=
JWT_SECRET_FILE=

# Encryption key for sensitive data (base64-encoded AES-GCM key)
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=

# Comma-separated frontend origins allowed by CORS.
# Example: https://studio.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional tracing / Apache SkyWalking POC
# Include docker/docker-compose.skywalking.yml and set enabled=true to export traces.
LUMIBASE_TRACING_ENABLED=false
LUMIBASE_TRACING_PROVIDER=skywalking
LUMIBASE_SERVICE_NAME=lumibase-cms
OTEL_EXPORTER_OTLP_ENDPOINT=http://skywalking-oap:11800
LUMIBASE_TRACING_SAMPLING_RATIO=1
SKYWALKING_OAP_GRPC_PORT=11800
SKYWALKING_OAP_HTTP_PORT=12800
SKYWALKING_UI_PORT=8080
