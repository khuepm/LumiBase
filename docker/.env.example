# LumiBase Docker Environment Variables
# Copy this file to .env and adjust values for your environment.

# Runtime mode (docker or cloudflare)
LUMIBASE_RUNTIME=docker

# PostgreSQL connection
DATABASE_URL=postgresql://lumibase:lumibase_dev@postgres:5432/lumibase
# Optional secret-file alternative. If DATABASE_URL is unset, Docker entrypoint
# reads the value from this file path before migrations/server startup.
DATABASE_URL_FILE=
# Production defaults to requiring sslmode=require/verify-ca/verify-full.
# Set DATABASE_SSL_MODE=disable only for private non-TLS test stacks.
DATABASE_SSL_MODE=require

# Redis connection
REDIS_URL=redis://redis:6379
REDIS_URL_FILE=

# S3-compatible storage (MinIO for local dev)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumibase-media

# MeiliSearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=lumibase_dev_key

# Imgproxy
IMGPROXY_URL=http://imgproxy:8080
IMGPROXY_KEY=736563726574
IMGPROXY_SALT=736563726574

# CMS server port
PORT=1989

# ── AI Copilot / LLM provider ───────────────────────────────────────────────
# openai | anthropic | claude | gemini | nvidia | vertex | workers-ai | echo
# `echo` (default) is a no-LLM keyword matcher; set a real provider to enable
# natural-language Copilot actions.
LLM_PROVIDER=echo
# Optional provider-specific model override.
LLM_MODEL=
# OpenAI
OPENAI_API_KEY=
# Anthropic / Claude
ANTHROPIC_API_KEY=
# Google Gemini (public Generative Language API)
GEMINI_API_KEY=
# NVIDIA hosted inference (build.nvidia.com / NIM) — OpenAI-compatible.
# Billed by NVIDIA. Point NVIDIA_BASE_URL at a self-hosted NIM container
# (e.g. on an AWS GPU instance) to use your own deployment instead.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
# Google Cloud Vertex AI (serves Gemini models). Billed to Google Cloud — NOT
# covered by AWS credit. VERTEX_ACCESS_TOKEN is a short-lived OAuth bearer,
# e.g. `gcloud auth print-access-token` (expires ~1h).
VERTEX_ACCESS_TOKEN=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Pressure limiter (Node/Docker CMS overload protection)
# Returns HTTP 503 with Retry-After when the Node.js event loop is overloaded.
LUMIBASE_PRESSURE_LIMITER_ENABLED=true
LUMIBASE_PRESSURE_LIMITER_SAMPLE_INTERVAL=250
LUMIBASE_PRESSURE_LIMITER_MAX_EVENT_LOOP_DELAY=1000
# Set to a value such as 0.99 to also reject requests when event loop utilization is too high.
LUMIBASE_PRESSURE_LIMITER_MAX_EVENT_LOOP_UTILIZATION=false
LUMIBASE_PRESSURE_LIMITER_RETRY_AFTER=5
LUMIBASE_PRESSURE_LIMITER_EXCLUDED_PATHS=/health,/metrics

# Production TLS reverse proxy overlay (docker-compose.tls.yml)
PUBLIC_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Optional host port overrides for docker-compose.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEILISEARCH_PORT=7700
IMGPROXY_PORT=8080
CMS_PORT=1989
BULL_BOARD_PORT=3001

# Authentication (OIDC via Logto)
LOGTO_ISSUER=
LOGTO_AUDIENCE=
JWT_SECRET=
JWT_SECRET_FILE=

# Encryption key for sensitive data (base64-encoded AES-GCM key)
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=

# Comma-separated frontend origins allowed by CORS.
# Example: https://studio.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional tracing / Apache SkyWalking POC
# Include docker/docker-compose.skywalking.yml and set enabled=true to export traces.
LUMIBASE_TRACING_ENABLED=false
LUMIBASE_TRACING_PROVIDER=skywalking
LUMIBASE_SERVICE_NAME=lumibase-cms
OTEL_EXPORTER_OTLP_ENDPOINT=http://skywalking-oap:11800
LUMIBASE_TRACING_SAMPLING_RATIO=1
SKYWALKING_OAP_GRPC_PORT=11800
SKYWALKING_OAP_HTTP_PORT=12800
SKYWALKING_UI_PORT=8080
