# LumiBase restore drill scheduler environment.
# Install as /etc/lumibase/restore-drill.env with mode 0640 and real secrets.

# Safety guard: set DATABASE_URL to production so the script can refuse a
# restore when RESTORE_DATABASE_URL accidentally matches it.
DATABASE_URL=postgresql://lumibase:prod-password@prod-db:5432/lumibase

# Dedicated restore target. Never point this at production.
RESTORE_DATABASE_URL=postgresql://lumibase:restore-password@restore-db:5432/lumibase_restore

# Backup source. Use a local file, s3:// URI, or filename under S3_BUCKET/BACKUP_PREFIX.
BACKUP_FILE=s3://lumibase-backups/backups/latest.sql.gz
BACKUP_PREFIX=backups
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=lumibase-backups
S3_ACCESS_KEY=replace-with-readonly-access-key
S3_SECRET_KEY=replace-with-readonly-secret-key

# Restore app validation.
RESTORE_APP_URL=https://restore-api.example.com
RESTORE_AUTH_HEADER=Authorization: Bearer replace-with-restore-token
RESTORE_SITE_HEADER=X-Lumi-Site: site_demo
MEDIA_CHECK_KEY=drill/restore-media.txt
REINDEX_URL=https://restore-ops.example.com/reindex
SEARCH_CHECK_URL=https://restore-api.example.com/api/v1/search?q=Cloudflare&collection=articles&limit=5
SEARCH_EXPECT_MIN_HITS=1

# Drill metadata and output.
DRILL_ENV=cloudflare
CLOUDFLARE_ENV=restore-drill
DRILL_REPORT_DIR=/var/lib/lumibase/restore-drill-reports
RESTORE_RESET_SCHEMA=true
