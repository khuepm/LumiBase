{
  "mcpServers": {
    "lumibase": {
      "command": "npx",
      "args": ["-y", "@lumibase/mcp-server@latest"],
      "env": {
        "LUMIBASE_URL": "https://api.<your-site>.lumibase.dev",
        "LUMIBASE_SITE_ID": "<your-site-id>",
        "LUMIBASE_TOKEN": "<your-api-token>"
      }
    }
  }
}
