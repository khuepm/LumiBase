# LumiBase — local development environment
#
# Copy to `.env` and adjust. `.gitignore` keeps `.env` out of git and keeps this
# example in.
#
# Nothing auto-loads this file: there is no dotenv hook in the workspace, and
# `pnpm db:migrate` in particular does not read it. Load it into your shell
# before running the CMS or a migration:
#
#   set -a && source .env && set +a
#
# Hostnames below are `localhost`, for running the CMS on your host against
# infrastructure in Docker. If you run the CMS *inside* Docker Compose instead,
# use `docker/.env.example` — that one addresses services by container name.
#
# Full reference: docs/en/deployment/environment-variables.md

# ── Runtime ─────────────────────────────────────────────────────────────────
# docker → Node.js (@hono/node-server, pg pool, Redis, MinIO)
# cloudflare → Workers bindings (Hyperdrive, KV, R2, Queues)
LUMIBASE_RUNTIME=docker
LUMIBASE_ENV=development

# Local-only auth bypass for the setup/login flow. Never set this outside
# development — production ignores it, but staging running a dev env would not.
LUMIBASE_DEV_AUTH=true

# Minimum 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-long

# ── Database ────────────────────────────────────────────────────────────────
# Matches docker/docker-compose.yml (user `lumibase`, password `lumibase_dev`).
DATABASE_URL=postgresql://lumibase:lumibase_dev@localhost:5432/lumibase

# ── Cache + queues ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage (MinIO locally, S3/R2 in production) ────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumibase-media

# ── Search ──────────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=lumibase_dev_key

# ── Image transforms ────────────────────────────────────────────────────────
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=736563726574
IMGPROXY_SALT=736563726574

# ── CMS server ──────────────────────────────────────────────────────────────
PORT=1989

# ── Optional: encryption at rest ────────────────────────────────────────────
# Required before the first TOTP enrolment or CDC registry write, and it can
# never be removed afterwards — enrolled secrets are wrapped with it. Absent,
# those features fail closed rather than storing plaintext.
# ENCRYPTION_KEY=

# ── Optional: AI Copilot provider ───────────────────────────────────────────
# `echo` (default) is a no-LLM keyword matcher. Set a real provider to enable
# natural-language Copilot actions.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash
# GEMINI_API_KEY=
