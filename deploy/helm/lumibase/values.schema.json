{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "LumiBase Helm chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      }
    },
    "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "objectList": { "type": "array", "items": { "type": "object" } }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      }
    },
    "imagePullSecrets": { "$ref": "#/definitions/objectList" },
    "environment": { "type": "string", "enum": ["production", "staging", "development"] },
    "publicUrl": {
      "type": "string",
      "pattern": "^(https?://[^/\\s]+/?)?$",
      "description": "Public origin (scheme://host[:port]); becomes LUMIBASE_PUBLIC_URL."
    },
    "corsAllowedOrigins": { "type": "string" },
    "setup": {
      "type": "object",
      "properties": { "requireToken": { "type": "boolean" } }
    },
    "studio": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "config": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "extraEnv": { "$ref": "#/definitions/objectList" },
    "extraEnvFrom": { "$ref": "#/definitions/objectList" },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "jwtSecret": {
          "type": "string",
          "anyOf": [{ "maxLength": 0 }, { "minLength": 32 }],
          "description": "Min 32 characters when set."
        },
        "encryptionKey": { "type": "string" },
        "keepOnUninstall": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "cms": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "role": { "type": "string", "enum": ["all", "web"] },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "type": "object" },
        "tmpSizeLimit": { "type": "string" },
        "readinessPath": { "type": "string", "pattern": "^(/.*)?$" },
        "startupProbe": { "type": ["object", "null"] },
        "livenessProbe": { "type": ["object", "null"] },
        "readinessProbe": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 11 },
        "strategy": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/objectList" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "$ref": "#/definitions/objectList" },
        "priorityClassName": { "type": "string" }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535, "not": { "const": 1989 } },
        "resources": { "type": "object" }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["initContainer", "entrypoint", "none"] },
        "resources": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "$ref": "#/definitions/objectList" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "external": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "sslMode": { "type": "string", "enum": ["", "disable", "require", "verify-ca", "verify-full"] },
        "rls": { "type": "string", "enum": ["off", "enforce"] },
        "systemUrl": {
          "type": "object",
          "properties": {
            "value": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "properties": {
            "database": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
            "username": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
            "password": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$", "description": "URL-safe characters only; it is inserted into DATABASE_URL as is." },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "external": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "pattern": "^(rediss?://.+)?$" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "properties": {
            "password": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" }
      }
    },
    "meilisearch": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "external": {
          "type": "object",
          "properties": {
            "host": { "type": "string", "pattern": "^(https?://.+)?$" },
            "apiKey": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "image": { "$ref": "#/definitions/image" },
        "masterKey": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 16 }] },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" }
      }
    },
    "s3": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "pattern": "^(https?://.+)?$" },
        "bucket": { "type": "string", "minLength": 1 },
        "accessKey": { "type": "string" },
        "secretKey": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "tests": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
