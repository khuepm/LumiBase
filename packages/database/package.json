{
  "name": "@lumibase/database",
  "version": "0.10.0",
  "private": true,
  "description": "Lumibase Drizzle ORM schema and migrations (PostgreSQL via Cloudflare Hyperdrive).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:remote": "tsx scripts/migrate.ts",
    "migrate:kit": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:content-os-demo": "tsx scripts/seed-content-os-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "clean": "rm -rf .turbo drizzle dist",
    "migrate:preflight": "tsx scripts/migrate.ts preflight",
    "migrate:dry-run": "tsx scripts/migrate.ts dry-run",
    "migrate:version": "tsx scripts/migrate.ts version"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.0.7",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^3.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
