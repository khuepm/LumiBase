---
import VisualEditing from '../components/VisualEditing.astro';
import { contentConfig } from '../lib/lumibase';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A static site built with Astro and LumiBase.' } = Astro.props;
const preview = contentConfig.configured && contentConfig.config.preview;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    {preview && <p class="preview-banner">Draft preview build — unpublished content is visible.</p>}
    <main>
      <slot />
    </main>
    {preview && <VisualEditing />}
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }
  body {
    margin: 0;
  }
  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }
  code {
    font-size: 0.9em;
  }
  .preview-banner {
    margin: 0;
    padding: 0.5rem 1rem;
    text-align: center;
    background: #fde68a;
    color: #451a03;
  }
  .posts {
    list-style: none;
    padding: 0;
  }
  .posts li + li {
    margin-top: 1.5rem;
  }
  .muted {
    opacity: 0.7;
  }
</style>
