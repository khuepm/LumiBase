# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed, so
# every secret below stays EMPTY here. On Cloudflare Pages, set the same names
# under Settings -> Variables and Secrets (as secrets where noted).
#
# This site is built statically: content is read ONCE, at `astro build`, and
# the HTML in `dist/` is what visitors get. None of these variables reach the
# browser — they are declared `context: "server"` in astro.config.mjs and Astro
# refuses to inline them into client code.

# ─── Content (read at build time) ────────────────────────────────────────────

# Base URL of your LumiBase CMS. Leave empty to build the "connect your CMS"
# page instead of failing (useful for a first deploy).
LUMIBASE_URL=
LUMIBASE_SITE_ID=__default__
# A PUBLISHABLE key (`lbk_pub_…`): read-only, and its grant should be
# restricted to published rows. Least privilege even though it never ships to
# the browser — a build log or a cached artifact is still a place keys leak.
LUMIBASE_PUBLISHABLE_KEY=

# ─── Draft preview builds (optional) ─────────────────────────────────────────

# `true` builds drafts too. Set it ONLY on a protected preview environment
# (e.g. a Cloudflare Pages preview branch behind Cloudflare Access), never on
# production.
LUMIBASE_PREVIEW=false
# Secret (`lbk_…`, not `lbk_pub_…`) whose read grant includes drafts. Used only
# when LUMIBASE_PREVIEW=true. Store it as a Pages *secret*, never commit it.
LUMIBASE_PREVIEW_TOKEN=

# ─── Tooling only ────────────────────────────────────────────────────────────

# Read by `npm run types` (`lumibase types`) to fetch the schema manifest.
# Needs schema read access, so it is a secret. Not used by the build.
LUMIBASE_TOKEN=

# `npm run deploy` (wrangler pages deploy) reads these from the environment.
# In CI, set them as repository secrets instead of in this file.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
