# LumiBase CMS + Studio for local development.
#
# This pulls a PUBLISHED image rather than building from source, pinned to
# the exact version of create-lumibase that generated this project. The client
# in package.json is pinned to the same version, so the API, Studio and the
# `lumibase` package you install always come from one release.
#
# Semver tags are cut once by the release workflow and not rebuilt. Avoid
# `latest` (it can trail the prerelease line) and `edge` (rebuilt on every push
# to main). To upgrade, change this tag and the `lumibase` version in
# package.json together.
#
# The image serves BOTH the REST API and the Studio SPA on the same port, so
# there is no second container to run.

services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: lumibase
      POSTGRES_USER: lumibase
      POSTGRES_PASSWORD: lumibase_dev
    # Loopback only. Nothing outside this machine needs the database, and the
    # password here is a development default.
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U lumibase"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    # Loopback only; Redis has no auth configured here.
    ports:
      - "127.0.0.1:${REDIS_PORT:-6379}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

  cms:
    image: ghcr.io/khuepm/lumibase-cms:{{lumibaseVersion}}
    environment:
      LUMIBASE_RUNTIME: docker
      DATABASE_URL: postgresql://lumibase:lumibase_dev@postgres:5432/lumibase
      PORT: "1989"
      # Local development values. Both are REQUIRED for login to work at all
      # (the CMS refuses to sign a JWT without a secret). Replace them before
      # this stack is ever reachable from anywhere but your machine.
      JWT_SECRET: dev_secret_key
      ENCRYPTION_KEY: dev_secret_key
      # LUMIBASE_REQUIRE_SETUP_TOKEN is left off so `npm run cms:bootstrap`
      # works with no extra step. To gate setup, set it to "1": the CMS then
      # prints `SETUP_TOKEN=…` once at startup (`npm run cms:logs`); put that
      # value in LUMIBASE_SETUP_TOKEN in .env before bootstrapping.
      #
      # This stack is bound to localhost, so without the gate the exposure is a
      # local port rather than the internet. Run `npm run cms:bootstrap`
      # promptly: until you do, anyone who can reach :1989 can claim the admin
      # account.
      # The website runs on :3000 and calls the API on :1989 — a cross-origin
      # pair, so the browser sends a preflight the CMS must accept.
      CORS_ALLOWED_ORIGINS: ${LUMIBASE_PUBLIC_ORIGIN:-http://localhost:3000}
      # Without this the Docker runtime falls back to 127.0.0.1:6379 and floods
      # the log with ECONNREFUSED, which buries anything worth reading.
      REDIS_URL: redis://redis:6379
    # Bound to loopback DELIBERATELY, and it is what makes the note above
    # defensible: with the setup-token gate off and a fixed dev
    # JWT_SECRET, publishing this on 0.0.0.0 would let anyone who can reach the
    # port claim the admin account. `1989:1989` would do exactly that — Docker
    # publishes on ALL interfaces unless a host IP is given.
    #
    # Reaching this from another device (a phone on the same Wi-Fi, a colleague)
    # is not a matter of deleting `127.0.0.1`: replace JWT_SECRET and
    # ENCRYPTION_KEY first, and put a real origin in LUMIBASE_PUBLIC_ORIGIN.
    ports:
      - "127.0.0.1:${CMS_PORT:-1989}:1989"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

volumes:
  pgdata:
