import { Hono } from 'hono';
import { logger } from 'hono/logger';

export interface Env {
  DB: D1Database;
  JWT_SECRET: string;
  ADMIN_EMAIL: string;
}

const app = new Hono<{ Bindings: Env }>();

app.use('*', logger());

app.get('/', (c) => c.json({ name: '{{projectName}}', status: 'ok' }));

export default app;
