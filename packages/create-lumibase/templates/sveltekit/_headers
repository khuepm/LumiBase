# Cloudflare Pages headers for static assets. adapter-cloudflare expects this
# file in the project root (not in `static/`). Server-rendered pages set their
# own Cache-Control in `src/lib/server/lumibase.ts`.
#
# No X-Frame-Options / frame-ancestors here on purpose: Studio previews and
# future visual editing embed the site in an iframe. If you add one, allow
# your Studio origin, e.g.
#   Content-Security-Policy: frame-ancestors 'self' https://cms.example.com
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
