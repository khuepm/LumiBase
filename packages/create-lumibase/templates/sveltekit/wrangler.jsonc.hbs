// Cloudflare Pages project config, read by `npm run deploy` (wrangler pages
// deploy) and `npm run preview` (wrangler pages dev). Secrets do NOT belong in
// here — this file is committed. Set them with
//   npx wrangler pages secret put LUMIBASE_PUBLISHABLE_KEY
// or in the dashboard under Settings -> Variables and Secrets.
{
  "name": "{{projectName}}",
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_als"]
}
