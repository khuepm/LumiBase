{
  "name": "create-lumibase",
  "version": "1.0.0-rc.1",
  "description": "Scaffold a new LumiBase project — Edge-native Headless CMS",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-lumibase": "./bin/create-lumibase.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/postbuild.mjs",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "execa": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "lumibase",
    "cms",
    "headless-cms",
    "scaffold",
    "create"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khuepm/lumibase.git",
    "directory": "packages/create-lumibase"
  },
  "homepage": "https://docs.lumibase.dev",
  "bugs": {
    "url": "https://github.com/khuepm/lumibase/issues"
  }
}
