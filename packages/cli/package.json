{
  "name": "lumibase",
  "version": "0.26.0",
  "description": "LumiBase in one package — the JS/TS client (re-exports @lumibase/sdk) plus the `lumibase` CLI: generate TypeScript types from a live schema, check your setup, scaffold a project.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "lumibase": "./bin/lumibase.js"
  },
  "main": "./src/lib.ts",
  "types": "./src/lib.ts",
  "exports": {
    ".": "./src/lib.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/lib.js",
    "types": "./dist/lib.d.ts",
    "exports": {
      ".": {
        "types": "./dist/lib.d.ts",
        "import": "./dist/lib.js"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@lumibase/sdk": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "lumibase",
    "sdk",
    "client",
    "cli",
    "cms",
    "headless-cms",
    "typegen",
    "codegen",
    "typescript",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khuepm/lumibase.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.lumibase.dev",
  "bugs": {
    "url": "https://github.com/khuepm/lumibase/issues"
  }
}
