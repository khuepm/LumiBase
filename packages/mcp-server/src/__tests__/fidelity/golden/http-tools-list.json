    {
      "name": "createIntent",
      "description": "Create a content intent (declarative SLO) for a collection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "collection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "rules": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "schedule": {
            "type": "string",
            "pattern": "^(\\S+\\s+){4}\\S+$"
          },
          "budget": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "autonomyCap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "maintenanceWindow": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "collection",
          "rules",
          "schedule"
        ],
        "additionalProperties": false
