                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "onError": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "key"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "name",
          "triggerType",
          "graph"
        ],
        "additionalProperties": false
      }
