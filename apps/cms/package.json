{
  "name": "@lumibase/cms",
  "version": "0.25.0",
  "private": true,
  "description": "LumiBase CMS API — Hono.js on Cloudflare Workers.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "lumibase": "./scripts/cli.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 1989",
    "build": "node ../../scripts/with-build-metadata.mjs wrangler deploy --dry-run --outdir=dist",
    "build:dev": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env dev --dry-run --outdir=dist",
    "build:staging": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env staging --dry-run --outdir=dist",
    "build:demo": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env demo --dry-run --outdir=dist",
    "build:production": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env production --dry-run --outdir=dist",
    "build:node": "node ../../scripts/with-build-metadata.mjs esbuild src/serve.ts --bundle --platform=node --format=cjs --outfile=dist/serve.cjs --external:pg-native --external:cloudflare:workers --external:node-cron && node ../../scripts/with-build-metadata.mjs esbuild ../../packages/database/scripts/migrate.ts --bundle --platform=node --format=cjs --outfile=dist/migrate.cjs --external:pg-native && node ./scripts/copy-node-cron.mjs",
    "deploy": "pnpm run deploy:production",
    "deploy:dev": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env dev",
    "deploy:staging": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env staging",
    "deploy:demo": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env demo",
    "deploy:production": "node ../../scripts/check-release-env.mjs --env production --config apps/cms/wrangler.toml && node ../../scripts/with-build-metadata.mjs wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "typegen": "tsx scripts/typegen.ts",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "k6:login-brute": "k6 run k6/login-brute-force.js",
    "clean": "rm -rf .turbo .wrangler dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@lumibase/ai-skills": "workspace:*",
    "@lumibase/database": "workspace:*",
    "@lumibase/runtime": "workspace:*",
    "@lumibase/sdk": "workspace:*",
    "@lumibase/shared": "workspace:*",
    "@sentry/cloudflare": "^10.69.0",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.10.0",
    "hono": "^4.12.32",
    "jose": "^6.2.5",
    "maxmind": "5.0.6",
    "nanoid": "^5.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "9.0.3",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.1",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.0",
    "fast-check": "^3.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  }
}
