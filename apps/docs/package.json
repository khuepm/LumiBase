{
  "name": "@lumibase/docs",
  "version": "0.22.0",
  "private": true,
  "description": "LumiBase Docs Viewer — browse project documentation (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-public.js && vite",
    "build": "node ../../scripts/build-release-manifest.mjs && node scripts/sync-public.js && tsc -b && vite build && pnpm build:ssr && pnpm prerender && rm -rf dist-ssr",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@lumibase/shared": "workspace:*",
    "@lumibase/ui": "workspace:*",
    "@shikijs/rehype": "^4.0.2",
    "dompurify": "^3.4.11",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.452.0",
    "minisearch": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.22.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
