{
  "name": "@lumibase/docs",
  "version": "2.2.2",
  "private": true,
  "description": "LumiBase Docs Viewer — browse project documentation (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-public.js && vite",
    "build": "node ../../scripts/build-release-manifest.mjs && node scripts/sync-public.js && tsc -b && vite build && pnpm build:ssr && pnpm prerender && rm -rf dist-ssr && node scripts/copy-storybook.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lumibase/analytics-consent": "workspace:*",
    "@lumibase/contracts": "workspace:*",
    "@lumibase/ui": "workspace:*",
    "@shikijs/rehype": "^4.6.0",
    "dompurify": "^3.5.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.79.0",
    "minisearch": "^7.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.6.0",
    "swagger-ui-dist": "5.36.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
