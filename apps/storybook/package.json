{
  "name": "@lumibase/storybook",
  "version": "2.0.0",
  "private": true,
  "description": "Storybook for @lumibase/ui primitives and representative Studio components (a11y + visual regression). Published under the docs site at /storybook/.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run --project=guards",
    "test:stories": "vitest --run --project=stories-light --project=stories-dark",
    "test:visual": "node scripts/visual-snapshots.mjs",
    "clean": "rm -rf .turbo storybook-static visual-output"
  },
  "dependencies": {
    "@lumibase/sdk": "workspace:*",
    "@lumibase/ui": "workspace:*",
    "@tanstack/react-query": "^5.108.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "1.65.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.1"
  }
}
