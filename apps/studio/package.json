{
  "name": "@lumibase/studio",
  "version": "0.4.3",
  "private": true,
  "description": "LumiBase Studio — no-code admin SPA (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node ../../scripts/with-build-metadata.mjs vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@lumibase/sdk": "workspace:*",
    "@lumibase/shared": "workspace:*",
    "@lumibase/ui": "workspace:*",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.74.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.2.0",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
