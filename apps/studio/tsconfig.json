{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // No `baseUrl`: TypeScript 7 removed it (TS5102). Dropping it is a no-op
    // here because it was `"."` — `paths` without `baseUrl` resolve relative to
    // this tsconfig, which is the same directory. Vite resolves `@/*` from its
    // own `resolve.alias` in vite.config.ts, so the bundler is unaffected.
    "paths": {
      "@/*": ["./src/*"],
      "@lumibase/contracts": ["../../packages/contracts/src/index.ts"],
      "@lumibase/contracts/*": ["../../packages/contracts/src/*"],
      "@lumibase/extensions": ["../../packages/extensions/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts", "vite-plugins/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
