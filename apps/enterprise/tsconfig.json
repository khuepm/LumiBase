{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lumibase/shared": ["../../packages/shared/src/index.ts"],
      "@lumibase/shared/*": ["../../packages/shared/src/*"],
      "@lumibase/runtime": ["../../packages/runtime/src/index.ts"],
      "@lumibase/database": ["../../packages/database/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "wrangler.toml"],
  "exclude": ["node_modules", "dist"]
}
