{
  "name": "@lumibase/enterprise",
  "version": "0.8.0",
  "private": true,
  "description": "LumiBase Enterprise — private-only standalone app. Source lives in the private lumibase-enterprise repo and is mounted here as a git submodule.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 1995",
    "build": "node ../../scripts/with-build-metadata.mjs wrangler deploy --dry-run --outdir=dist",
    "deploy": "node ../../scripts/with-build-metadata.mjs wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "clean": "rm -rf .turbo .wrangler dist"
  },
  "dependencies": {
    "@lumibase/database": "workspace:*",
    "@lumibase/runtime": "workspace:*",
    "@lumibase/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.0",
    "wrangler": "^4.96.0"
  }
}
