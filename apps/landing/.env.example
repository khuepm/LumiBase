# Environment variables for LumiBase Landing Page
# Copy this file to .env.local and fill in your values

# GitHub repository URL (replace with actual URL)
NEXT_PUBLIC_GITHUB_REPO=https://github.com/khuepm/lumibase

# Documentation URL
NEXT_PUBLIC_DOCS_URL=https://docs.lumibase.dev

# Google Analytics 4 measurement ID (optional, format G-XXXXXXX).
#
# Unset = no GA tag and no cookie banner; Cloudflare Web Analytics still counts
# traffic cookielessly. Set it and the tag loads only after the visitor opts in.
# Inlined at build time (static export), so changing it requires a rebuild.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
