{
  "name": "lumibase",
  "version": "0.1.0",
  "private": true,
  "description": "Lumibase - Edge-native Headless CMS (Turborepo monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @lumibase/database generate",
    "db:migrate": "pnpm --filter @lumibase/database migrate",
    "db:studio": "pnpm --filter @lumibase/database studio",
    "auth:reset-all": "pnpm --filter @lumibase/auth dev:reset-all",
    "auth:create-user": "pnpm --filter @lumibase/auth dev:create-user",
    "auth:reset-user": "pnpm --filter @lumibase/auth dev:reset-user",
    "landing:dev": "pnpm --filter @lumibase/landing dev",
    "landing:build": "pnpm --filter @lumibase/landing build",
    "landing:preview": "pnpm --filter @lumibase/landing preview",
    "docs:dev": "pnpm --filter @lumibase/docs dev",
    "docs:build": "pnpm --filter @lumibase/docs build",
    "docs:preview": "pnpm --filter @lumibase/docs preview",
    "landing:deploy": "pnpm landing:build && wrangler pages deploy apps/landing/out --project-name lumibase-landing",
    "docs:deploy": "pnpm docs:build && wrangler pages deploy apps/docs/dist --project-name lumibase-docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "wrangler": "^3.80.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.3",
      "@types/react-dom": "18.3.0"
    }
  }
}
