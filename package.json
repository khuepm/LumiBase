{
  "name": "lumibase",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "LumiBase - Edge-native Headless CMS (Turborepo monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!@lumibase/shell",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @lumibase/database generate",
    "db:migrate": "pnpm --filter @lumibase/database migrate",
    "db:seed-dev": "pnpm --filter @lumibase/database seed:dev",
    "db:studio": "pnpm --filter @lumibase/database studio",
    "auth:reset-all": "pnpm --filter @lumibase/auth dev:reset-all",
    "auth:create-user": "pnpm --filter @lumibase/auth dev:create-user",
    "auth:reset-user": "pnpm --filter @lumibase/auth dev:reset-user",
    "landing:dev": "pnpm --filter @lumibase/landing dev",
    "landing:build": "pnpm --filter @lumibase/landing build",
    "landing:preview": "pnpm --filter @lumibase/landing preview",
    "docs:dev": "pnpm --filter @lumibase/docs dev",
    "docs:build": "pnpm --filter @lumibase/docs build",
    "docs:preview": "pnpm --filter @lumibase/docs preview",
    "docs:i18n:detect": "node scripts/docs-i18n/sync.mjs",
    "docs:i18n:preserve": "node scripts/docs-i18n/sync.mjs --preserve-only",
    "docs:i18n:sync": "node scripts/docs-i18n/sync.mjs --apply",
    "docs:i18n:verify": "node scripts/docs-i18n/verify-code-refs.mjs",
    "docs:i18n:parity": "node scripts/docs-i18n/check-parity.mjs",
    "docs:i18n:stamp": "node scripts/docs-i18n/stamp-pair.mjs",
    "studio:dev": "pnpm --filter @lumibase/studio dev",
    "cms:dev": "pnpm --filter @lumibase/cms dev",
    "release:check": "node scripts/check-release-env.mjs --env production --config apps/cms/wrangler.toml",
    "cms:deploy": "pnpm release:check && pnpm --filter @lumibase/cms build:production && pnpm --filter @lumibase/cms deploy:production",
    "lumibase": "turbo run dev --filter=@lumibase/studio --filter=@lumibase/cms",
    "landing:deploy": "pnpm landing:build && wrangler pages deploy apps/landing/out --project-name lumibase-landing",
    "docs:deploy": "pnpm docs:build && wrangler pages deploy dist --project-name lumibase-docs --branch main --cwd apps/docs",
    "marketplace:dev": "pnpm --filter @lumibase/marketplace dev",
    "marketplace:build": "pnpm --filter @lumibase/marketplace build",
    "marketplace:preview": "pnpm --filter @lumibase/marketplace start",
    "marketplace:deploy": "pnpm marketplace:build && wrangler pages deploy apps/marketplace/out --project-name lumibase-marketplace",
    "prepare": "husky",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "registry:check": "node scripts/check-registry-numbering.mjs",
    "settings:check": "node scripts/check-pnpm-settings-parity.mjs",
    "drift:check": "node scripts/check-override-drift.mjs",
    "dist-tags:check": "node scripts/check-npm-dist-tags.mjs",
    "dist-tags:fix": "node scripts/check-npm-dist-tags.mjs --fix",
    "check:all": "pnpm version:check && pnpm registry:check && pnpm settings:check && pnpm drift:check && pnpm scripts:test",
    "scripts:test": "node --test \"scripts/__tests__/*.test.mjs\"",
    "db:migrate:preflight": "pnpm --filter @lumibase/database migrate:preflight",
    "db:migrate:dry-run": "pnpm --filter @lumibase/database migrate:dry-run",
    "db:migrate:version": "pnpm --filter @lumibase/database migrate:version"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^5.6.2",
    "wrangler": "^4.127.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@5": "^5.0.8",
      "dompurify": "^3.4.13",
      "esbuild": "^0.28.2",
      "fast-uri": "4.1.3",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.1",
      "nanoid@3": "^3.3.17",
      "postcss": "^8.5.26",
      "sharp": ">=0.35.0",
      "undici": "^7.28.0",
      "uuid": "^14.0.1",
      "vite": "^8.2.0",
      "ws": "^8.21.3"
    },
    "patchedDependencies": {
      "gray-matter@4.0.3": "patches/gray-matter@4.0.3.patch"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    }
  }
}
