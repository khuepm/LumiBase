# Base URL of the LumiBase API server
LUMIBASE_URL=http://127.0.0.1:1989

# Bearer token / API key from LumiBase Studio.
# IMPORTANT: use a PUBLIC-scoped token. NEVER use a token that holds the
# `read_decrypted` permission in a frontend — it would expose pii/phi.
LUMIBASE_TOKEN=your-public-lumibase-token

# Active tenant Site ID
LUMIBASE_SITE_ID=your-site-id
