# Base URL of the LumiBase CMS this extension talks to.
EXTENSION_LUMIBASE_BASE_URL=http://localhost:1989

# A LumiBase API token with site-admin scope (the /api/v1/email/* surface is
# gated by requireSiteAdmin). Create one under Settings → Access → API keys.
EXTENSION_LUMIBASE_API_TOKEN=

# The site this extension sends mail on behalf of.
EXTENSION_LUMIBASE_SITE_ID=__default__

# Which stored template to send. Author it in Studio → Settings → Email.
EXTENSION_EMAIL_TEMPLATE_KEY=teammate_invite

# Local dev server port for this example.
PORT=3006
